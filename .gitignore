# Environment Variables (Frontend & Backend)
.env
.env.local
.env.development
.env.test
.env.production
.env.development.local
.env.test.local
.env.production.local

# Logs & Debugging Files
*.log
debug.log
error.log
out.log

# System & Editor-Specific Files
.DS_Store
.vscode/
